HEVY_API_KEY=HEVY_KEY
# Optional timeout for Hevy API requests in milliseconds (default: 30000)
# HEVY_MCP_API_TIMEOUT=30000
# Enable privacy-bounded debug diagnostics on stderr (only 1 enables it)
# HEVY_MCP_DEBUG=1
# Self-hosted OAuth transport (--transport http+oauth), fork-specific
# Public base URL of this server; required for http+oauth
# MCP_ISSUER_URL=https://mcp.example.com
# Consent-form password. Unset or empty rejects every login (fails closed)
# MCP_AUTH_PASSWORD=change-me
# SQLite file holding OAuth clients and tokens (default: ./oauth.db)
# OAUTH_DB_PATH=/data/oauth.db
